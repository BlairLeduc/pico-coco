10 N=0:K=0
20 N=N+1:CLS N AND 7:GOSUB 200
30 FOR I=3 TO 14:PRINT@I*32+2,"SOAK";I+N;:NEXT
40 SOUND 50+(N AND 127),1:PLAY "T40O3CEGO4C"
50 PMODE 4,1:PCLS:SCREEN 1,N AND 1
60 FOR I=1 TO 12:CIRCLE(RND(256)-1,RND(192)-1),RND(40):NEXT
70 LINE(0,0)-(255,191),PSET:SCREEN 0,0
80 FOR T=1 TO 150:A$=INKEY$:IF A$<>"" THEN K=ASC(A$)
90 NEXT:GOSUB 200:GOTO 20
200 A$=INKEY$:IF A$<>"" THEN K=ASC(A$)
210 PRINT@0,"C";N;"K";K;
220 RETURN
